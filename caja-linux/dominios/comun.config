# Dominio de controladores (S35): lo común a todos, encima de `make tinyconfig`. Fichero propio de DashOS; las
# opciones salen de la documentación del kernel (Kconfig y Documentation/), no de configuraciones de otros.
#
# Sin módulos (capa 2 de S35) y sin disco: todo va dentro de la Image y el /init va en el initramfs.
CONFIG_MODULES=n
CONFIG_BLK_DEV_INITRD=y
CONFIG_INITRAMFS_SOURCE=""
CONFIG_BINFMT_ELF=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_DEVTMPFS=y
# Registro del kernel: lo que el dominio dice sale por su canal con DashOS ("Los dominios se dejan mirar").
CONFIG_PRINTK=y
CONFIG_PRINTK_TIME=y
CONFIG_TTY=y
CONFIG_VT=n
# Varios procesadores; NR_CPUS se fija en cada arquitectura (el valor de serie, 512 o 64, gasta memoria por CPU posible).
CONFIG_SMP=y
CONFIG_HIGH_RES_TIMERS=y
CONFIG_NO_HZ_IDLE=y
CONFIG_FUTEX=y
# PCI: la tarjeta con cable y el xHCI que ve el dominio son aparatos PCI de la máquina virtual.
CONFIG_PCI=y
CONFIG_PCI_MSI=y
# Red sin IP: el servidor pasa tramas enteras entre el aparato y DashOS con un socket de paquetes.
CONFIG_NET=y
CONFIG_PACKET=y
CONFIG_UNIX=y
CONFIG_INET=n
CONFIG_NETDEVICES=y
CONFIG_NET_CORE=y
# El canal con DashOS: virtio (red y consola para el registro).
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_HVC_DRIVER=y
# Ni la ayuda de depuración ni los símbolos del kernel.
CONFIG_KALLSYMS=n
CONFIG_DEBUG_INFO_NONE=y
