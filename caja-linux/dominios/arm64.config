# aarch64, placa virt de QEMU: GICv3 o v2, temporizador, PSCI, PL011, PCIe genérico (ECAM).
CONFIG_NR_CPUS=8
CONFIG_ARM64_4K_PAGES=y
CONFIG_OF=y
CONFIG_ARM_GIC=y
CONFIG_ARM_GIC_V3=y
CONFIG_ARM_ARCH_TIMER=y
CONFIG_ARM_PSCI_FW=y
CONFIG_ARM_AMBA=y
CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y
CONFIG_PCI_HOST_GENERIC=y
