# Dominio de gráficos de x86-64 (X12, G5 de docs/diseño/S38-gpu-escritorio.md), encima de `make tinyconfig`. Fichero
# propio de DashOS; las opciones salen de la documentación del kernel (Kconfig y Documentation/), no de configuraciones
# de otros. Base: x86_ntfs.config (la máquina del hipervisor de DashOS), con PCI, DRM y lo que pide Mesa.
#
# La máquina: 1 CPU, tabla MP de Intel (sin ACPI), LAPIC con el temporizador en plazo del TSC, un IOAPIC, la consola
# temprana en el 0x3F8 y un bus PCI por los puertos 0xCF8/0xCFC (mecanismo 1) con un puente y la GPU pasada, con MSI-X.
CONFIG_64BIT=y
CONFIG_SMP=n
CONFIG_NR_CPUS=1
CONFIG_MODULES=n
CONFIG_BLK_DEV_INITRD=y
CONFIG_INITRAMFS_SOURCE=""
CONFIG_RD_GZIP=n
CONFIG_RD_BZIP2=n
CONFIG_RD_LZMA=n
CONFIG_RD_XZ=n
CONFIG_RD_LZO=n
CONFIG_RD_LZ4=n
CONFIG_RD_ZSTD=n
CONFIG_BINFMT_ELF=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_DEVTMPFS=y
# Lo que usan musl y Mesa: hilos (futex), epoll y eventfd, temporizadores POSIX, memoria compartida (tmpfs, memfd) y
# cerrojos de ficheros.
CONFIG_MULTIUSER=y
CONFIG_FUTEX=y
CONFIG_EPOLL=y
CONFIG_EVENTFD=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_POSIX_TIMERS=y
CONFIG_SHMEM=y
CONFIG_TMPFS=y
CONFIG_MEMFD_CREATE=y
CONFIG_ADVISE_SYSCALLS=y
CONFIG_FILE_LOCKING=y
# Interrupciones: como en x86_ntfs.config.
CONFIG_X86_LOCAL_APIC=y
CONFIG_X86_IO_APIC=y
CONFIG_X86_MPPARSE=y
CONFIG_X86_X2APIC=n
CONFIG_ACPI=n
# El PCI, sin ACPI ni BIOS: el mecanismo 1 de configuración (puertos 0xCF8 y 0xCFC) y las MSI y MSI-X.
CONFIG_PCI=y
CONFIG_PCI_MSI=y
CONFIG_HYPERVISOR_GUEST=n
CONFIG_PARAVIRT=n
CONFIG_DMI=n
CONFIG_MTRR=n
CONFIG_X86_PAT=n
CONFIG_X86_MCE=n
CONFIG_X86_KERNEL_IBT=n
CONFIG_X86_USER_SHADOW_STACK=n
CONFIG_X86_INTEL_MEMORY_PROTECTION_KEYS=n
CONFIG_CPU_MITIGATIONS=n
CONFIG_RANDOMIZE_BASE=n
CONFIG_IA32_EMULATION=n
CONFIG_PHYSICAL_START=0x200000
CONFIG_HZ_100=y
CONFIG_NO_HZ_IDLE=y
# La GPU: DRM con el controlador de virtio-gpu (KMS y 3D con virgl), por virtio-pci moderno. Sin consola de marco
# (fbdev): la pantalla es del /init.
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_PCI_LEGACY=n
CONFIG_DRM=y
CONFIG_DRM_VIRTIO_GPU=y
CONFIG_DRM_VIRTIO_GPU_KMS=y
CONFIG_DRM_FBDEV_EMULATION=n
CONFIG_FB=n
CONFIG_PRINTK=y
CONFIG_PRINTK_TIME=y
CONFIG_EARLY_PRINTK=y
CONFIG_TTY=n
CONFIG_SERIAL_8250=n
CONFIG_KALLSYMS=n
CONFIG_DEBUG_INFO_NONE=y
