# Dominio de red servido a DashOS (S35, paso 2; docs/bitacoras/dominio-red.md). Encima de comun.config y arm64.config.
#
# La tarjeta: la Intel e1000 (82540EM) que emula QEMU, pasada por DashOS al dominio sin IOMMU (paso intermedio, solo en
# QEMU). PCI clásico, sin MSI: su interrupción es la INTx que el hipervisor reenvía.
CONFIG_ETHERNET=y
CONFIG_NET_VENDOR_INTEL=y
CONFIG_E1000=y
# Su DMA, en una zona propia que el hipervisor pone en la misma dirección que en la máquina (restricted-dma-pool).
CONFIG_OF_RESERVED_MEM=y
CONFIG_SWIOTLB=y
CONFIG_DMA_RESTRICTED_POOL=y
# El canal con DashOS: su página de registros y su interrupción, por UIO (uio_pdrv_genirq, con of_id en la línea).
CONFIG_UIO=y
CONFIG_UIO_PDRV_GENIRQ=y
# La ventana (las colas y búferes del conductor de DashOS), por /dev/mem.
CONFIG_DEVMEM=y
CONFIG_STRICT_DEVMEM=n
# Aquí no hace falta virtio en el dominio (el canal es el propio); la consola es el PL011.
CONFIG_VIRTIO_NET=n
CONFIG_VIRTIO_PCI=n
