# x86-64, máquina q35 de QEMU con KVM: consola serie 8250, ACPI (para el PCIe y los procesadores).
CONFIG_64BIT=y
CONFIG_NR_CPUS=8
CONFIG_ACPI=y
CONFIG_PCI_MMCONFIG=y
CONFIG_X86_LOCAL_APIC=y
CONFIG_X86_IO_APIC=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_HYPERVISOR_GUEST=y
CONFIG_PARAVIRT=y
CONFIG_KVM_GUEST=y
