# Dominio Linux mínimo de x86-64 para ntfsresize (docs/bitacoras/x86-dominio.md), encima de `make tinyconfig`. Solo
# este fichero: no lleva comun.config (aquí no hay red, ni PCI, ni varias CPU). Fichero propio de DashOS; las opciones
# salen de la documentación del kernel (Kconfig y Documentation/), no de configuraciones de otros.
#
# La máquina es la que da el hipervisor de DashOS: 1 CPU, 128 MB, tabla MP de Intel (sin ACPI), LAPIC con el
# temporizador en plazo del TSC, un IOAPIC, un virtio-blk por virtio-mmio y la consola temprana en el 0x3F8.
CONFIG_64BIT=y
# Una CPU: sin SMP (no hay que despertar otras con INIT/SIPI) y sus tablas por CPU, para una.
CONFIG_SMP=n
CONFIG_NR_CPUS=1
# Sin módulos: todo va dentro de la bzImage y el /init va en el initramfs (sin comprimir: el cpio tal cual).
CONFIG_MODULES=n
CONFIG_BLK_DEV_INITRD=y
CONFIG_INITRAMFS_SOURCE=""
CONFIG_RD_GZIP=n
CONFIG_RD_BZIP2=n
CONFIG_RD_LZMA=n
CONFIG_RD_XZ=n
CONFIG_RD_LZO=n
CONFIG_RD_LZ4=n
CONFIG_RD_ZSTD=n
CONFIG_BINFMT_ELF=y
CONFIG_PROC_FS=y
CONFIG_DEVTMPFS=y
# ntfs-3g pone un cerrojo (fcntl F_SETLK) al abrir el disco; sin esto el kernel contesta EACCES y no lo abre.
CONFIG_FILE_LOCKING=y
# Las interrupciones: LAPIC e IOAPIC descritos por la tabla MP (MP 1.4) en memoria baja. Sin ACPI, X86_MPPARSE no se
# puede quitar; se nombra para que se vea. Sin x2APIC (necesitaría IRQ_REMAP o HYPERVISOR_GUEST, que no van).
CONFIG_X86_LOCAL_APIC=y
CONFIG_X86_IO_APIC=y
CONFIG_X86_MPPARSE=y
CONFIG_X86_X2APIC=n
CONFIG_ACPI=n
CONFIG_PCI=n
# Ni el reloj del hipervisor (kvmclock) ni la paravirtualización: el reloj es el TSC y el monitor de DashOS no es KVM.
CONFIG_HYPERVISOR_GUEST=n
CONFIG_PARAVIRT=n
# Menos cosas que lee del firmware o de MSR al arrancar y que aquí no hay o no sirven: la tabla DMI (SMBIOS), los MTRR
# y el PAT (sus MSR), la comprobación de máquina (MCE, sus MSR) y lo de seguridad de CPU que solo toca MSR o CR4 (IBT,
# pila sombra, llaves de protección). Las mitigaciones de canales laterales tampoco: dentro solo corre ntfsresize, y
# quitarlas evita los MSR de especulación (SPEC_CTRL y compañía). Sin aleatorizar dónde va el kernel (no hay RDRAND
# ni EFI que lo pida).
CONFIG_DMI=n
CONFIG_MTRR=n
CONFIG_X86_PAT=n
CONFIG_X86_MCE=n
CONFIG_X86_KERNEL_IBT=n
CONFIG_X86_USER_SHADOW_STACK=n
CONFIG_X86_INTEL_MEMORY_PROTECTION_KEYS=n
CONFIG_CPU_MITIGATIONS=n
CONFIG_RANDOMIZE_BASE=n
CONFIG_IA32_EMULATION=n
# El kernel se descomprime en 2 MB (de serie, 16 MB, para dejar libre la zona del DMA de ISA, que aquí no hay): baja
# la memoria mínima de la máquina.
CONFIG_PHYSICAL_START=0x200000
# El reloj: 100 interrupciones por segundo mientras trabaja y ninguna en reposo (cada una es una salida al monitor).
CONFIG_HZ_100=y
CONFIG_NO_HZ_IDLE=y
# El disco: virtio-blk por virtio-mmio (versión 2), nombrado en la línea del kernel (virtio_mmio.device=...). Es la
# partición NTFS entera, sin tabla: ningún lector de tablas de particiones (el sector de arranque de NTFS lleva 0x55AA
# y un lector de MBR podría tomarlo por una tabla).
CONFIG_BLOCK=y
CONFIG_BLK_DEV=y
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO=y
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_MMIO_CMDLINE_DEVICES=y
CONFIG_VIRTIO_BLK=y
CONFIG_PARTITION_ADVANCED=y
CONFIG_MSDOS_PARTITION=n
CONFIG_EFI_PARTITION=n
# Registro del kernel: sale por la consola temprana (earlyprintk, escritura sondeada en el 0x3F8), sin el controlador
# 8250 ni terminales. El /init escribe su resultado en /dev/kmsg, que va por el mismo camino.
CONFIG_PRINTK=y
CONFIG_PRINTK_TIME=y
CONFIG_EARLY_PRINTK=y
CONFIG_TTY=n
CONFIG_SERIAL_8250=n
# Ni la ayuda de depuración ni los símbolos del kernel.
CONFIG_KALLSYMS=n
CONFIG_DEBUG_INFO_NONE=y
