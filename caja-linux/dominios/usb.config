# Dominio de red con un aparato USB prestado (S35, paso 2; docs/bitacoras/dominio-usb.md). Encima de comun.config y
# arm64.config, en lugar de paso.config (la e1000 por PCI, retirada).
#
# El aparato no es del dominio: el xHCI lo lleva DashOS y lo presta por USB/IP. El dominio lo engancha con el
# controlador anfitrión virtual de USB/IP (vhci-hcd, de serie en Linux), a través de un socket que su /init pasa por el
# canal con DashOS. Sin PCI, sin IOMMU y sin DMA del aparato en el dominio: vale en cualquier máquina.
CONFIG_PCI=n
CONFIG_PCI_MSI=n
CONFIG_PCI_HOST_GENERIC=n
CONFIG_USB_SUPPORT=y
CONFIG_USB=y
CONFIG_USBIP_CORE=y
CONFIG_USBIP_VHCI_HCD=y
CONFIG_USBIP_VHCI_HC_PORTS=8
CONFIG_USBIP_VHCI_NR_HCS=1
CONFIG_USBIP_HOST=n
CONFIG_USBIP_VUDC=n
# Los adaptadores de red USB de clase (CDC Ethernet; RNDIS lo usan muchos y el usb-net de QEMU lo ofrece también).
CONFIG_USB_NET_DRIVERS=y
CONFIG_USB_USBNET=y
CONFIG_USB_NET_CDCETHER=y
CONFIG_USB_NET_RNDIS_HOST=y
CONFIG_USB_NET_CDC_NCM=n
CONFIG_USB_NET_AX8817X=n
CONFIG_USB_NET_AX88179_178A=n
CONFIG_USB_NET_NET1080=n
CONFIG_USB_NET_CDC_SUBSET=n
CONFIG_USB_NET_ZAURUS=n
# El canal con DashOS: su página de registros y su interrupción, por UIO (uio_pdrv_genirq, con of_id en la línea).
CONFIG_UIO=y
CONFIG_UIO_PDRV_GENIRQ=y
# La ventana (las colas y búferes del conductor de DashOS) y el tubo de USB/IP, por /dev/mem.
CONFIG_DEVMEM=y
CONFIG_STRICT_DEVMEM=n
# Aquí no hace falta virtio en el dominio (el canal es el propio); la consola es el PL011.
CONFIG_VIRTIO_NET=n
CONFIG_VIRTIO_PCI=n
