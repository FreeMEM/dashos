# Dominio de Wi-Fi (S35, paso 1): la pila (cfg80211 y mac80211), mac80211_hwsim para medirla sin aparato (QEMU no
# emula ningún Wi-Fi) y un controlador de Wi-Fi USB común (rt2800usb: las llaves Ralink/MediaTek RT5370, RT3070...)
# con el USB que necesita (xHCI). El firmware del aparato iría en la imagen del dominio; aquí no hace falta: sin aparato
# no se pide.
CONFIG_WIRELESS=y
CONFIG_CFG80211=y
CONFIG_MAC80211=y
CONFIG_MAC80211_RC_MINSTREL=y
CONFIG_WLAN=y
CONFIG_MAC80211_HWSIM=y
CONFIG_USB_SUPPORT=y
CONFIG_USB=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_XHCI_PCI=y
CONFIG_WLAN_VENDOR_RALINK=y
CONFIG_RT2X00=y
CONFIG_RT2800USB=y
CONFIG_FW_LOADER=y
