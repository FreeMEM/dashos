+/*
+    DashOS (F1, docs/PPC_LOOP.md): la máscara MB..ME de rlwinm, rlwimi y rlwnm como inmediato lógico de ARM (w unos
+    rotados r a la derecha). Si MB > ME la máscara da la vuelta: 32 - (MB - ME - 1) unos, no MB - ME - 1 (eso eran
+    los ceros). Y la máscara complementaria (la de bic) con su rotación módulo 32: con 6 bits no se codifica.
+*/
+static inline void ppcMask(uint8_t mb, uint8_t me, uint8_t &w, uint8_t &r)
+{
+    w = (mb <= me) ? 1 + me - mb : 33 + me - mb;
+    r = (me + 1) & 31;
+}
