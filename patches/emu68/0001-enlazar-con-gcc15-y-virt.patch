+
+/*
+    DashOS: capstone (Mapping.c) llama a printf en sus mensajes de error.
+    Con GCC 15 esas llamadas quedan sin resolver al enlazar.
+*/
+int printf(const char * restrict format, ...)
+{
+    va_list v;
+    va_start(v, format);
+    vkprintf(format, v);
+    va_end(v);
+    return 0;
+}
