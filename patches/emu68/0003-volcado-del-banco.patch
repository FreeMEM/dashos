diff --git a/src/M68k_Exception.c b/src/M68k_Exception.c
index c451c0d..163aa22 100644
--- a/src/M68k_Exception.c
+++ b/src/M68k_Exception.c
@@ -60,8 +60,13 @@ void EMIT_Exception(struct TranslatorContext *ctx, uint16_t exception, uint8_t f
     EMIT(ctx,
         mov_reg(0, sr),
         mov_immed_u16(2, val & 0xffff, 0),
-        movk_immed_u16(2, val >> 16, 1),
-        orr64_immed(2, 2, 25, 25, 1),
+        movk_immed_u16(2, val >> 16, 1)
+    );
+#ifndef DASHOS_HOST
+    /* DashOS: en el banco de pruebas (un programa de Linux) el código no está en la mitad alta */
+    EMIT(ctx, orr64_immed(2, 2, 25, 25, 1));
+#endif
+    EMIT(ctx,
         blr(2),
         mov_reg(sr, 0)
     );
diff --git a/src/M68k_LINEF.c b/src/M68k_LINEF.c
