+int addzex(PPCTranslatorContext* tc, uint32_t opcode) { return xoCarry(tc, opcode, Carry::ADDZE); }
+int addmex(PPCTranslatorContext* tc, uint32_t opcode) { return xoCarry(tc, opcode, Carry::ADDME); }
+int subfzex(PPCTranslatorContext* tc, uint32_t opcode) { return xoCarry(tc, opcode, Carry::SUBFZE); }
+int subfmex(PPCTranslatorContext* tc, uint32_t opcode) { return xoCarry(tc, opcode, Carry::SUBFME); }
