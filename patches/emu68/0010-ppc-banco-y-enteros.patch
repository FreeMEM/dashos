+/*
+    DashOS (F1, docs/PPC_LOOP.md): subfe, addze, addme, subfze y subfme, que faltaban, en su forma general. Todas
+    son rD = x + y + CA con el acarreo de ARM: adcs (rA + rB + C) y sbcs (rn + ~rm + C, que es rn - rm - !C).
+        subfe   ~rA + rB + CA   sbcs(rD, rB, rA)
+        addze    rA + 0  + CA   adcs(rD, rA, ZR)
+        addme    rA + -1 + CA   adcs(rD, rA, -1)
+        subfze  ~rA + 0  + CA   sbcs(rD, ZR, rA)
+        subfme  ~rA + -1 + CA   sbcs(rD, -1, rA)
+    CA sale del acarreo de ARM; OV (con OE) de V; CR0 (con Rc) de comparar el resultado con 0.
+*/
+enum class Carry { SUBFE, ADDZE, ADDME, SUBFZE, SUBFME };
+
+static int xoCarry(PPCTranslatorContext* tc, uint32_t opcode, Carry kind)
+{
+    uint8_t rd = (opcode >> 21) & 31;
+    uint8_t ra = (opcode >> 16) & 31;
+    uint8_t rb = (opcode >> 11) & 31;
+    uint8_t oe = (opcode >> 10) & 1;
+    uint8_t rc = opcode & 1;
+
+    GPR reg_ra = tc->mapGPRForRead(ra);
+    GPR reg_rb = (kind == Carry::SUBFE) ? tc->mapGPRForRead(rb) : GPR::allocate();
+    GPR reg_rd = tc->mapGPRForWrite(rd);
+    GPR tmp = GPR::allocate();
+    GPR reg_xer = tc->mapGPRForReadAndWrite(XERn);
+
+    if (kind == Carry::ADDME || kind == Carry::SUBFME)
+        tc->emit(movn_immed_u16(reg_rb, 0, 0));     /* -1 */
+
+    tc->emit({
+        ubfx(tmp, reg_xer, 29, 1),                  /* CA ... */
+        subs_immed(WZR, tmp, 1),                    /* ... into the C flag */
+        bic_immed(reg_xer, reg_xer, 1, 3)           /* CA = 0 */
+    });
+
+    switch (kind) {
+        case Carry::SUBFE:  tc->emit(sbcs(reg_rd, reg_rb, reg_ra)); break;
+        case Carry::ADDZE:  tc->emit(adcs(reg_rd, reg_ra, WZR)); break;
+        case Carry::ADDME:  tc->emit(adcs(reg_rd, reg_ra, reg_rb)); break;
+        case Carry::SUBFZE: tc->emit(sbcs(reg_rd, WZR, reg_ra)); break;
+        case Carry::SUBFME: tc->emit(sbcs(reg_rd, reg_rb, reg_ra)); break;
+    }
+
+    tc->emit({
+        orr_immed(tmp, reg_xer, 1, 3),
+        csel(reg_xer, tmp, reg_xer, A64_CC_CS)      /* CA = C */
+    });
+
+    if (oe) {
+        tc->emit({
+            bic_immed(reg_xer, reg_xer, 1, 2),      /* OV = 0, SO stays */
+            orr_immed(tmp, reg_xer, 2, 2),
+            csel(reg_xer, tmp, reg_xer, A64_CC_VS)
+        });
+    }
+
+    if (rc) {
+        tc->emit(cmp_immed(reg_rd, 0));
+        setCRnSigned(tc, 0);
+    }
+
+    tc->advancePC(4);
+
+    return 1;
+}
