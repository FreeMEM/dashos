+    lswx/stswx: the count (XER[25-31]) is only known at run time, and the register each byte goes to as well. All
+    GPRs are written to the GPR array of PPCState (it holds no live data while translated code runs: the loop
+    saves the context before reading it), the bytes are copied between memory and that array in a loop (byte i
+    to GPR[rD] + i, modulo 128), and the GPRs are loaded back from it (lswx only). A count of 0 changes nothing.
+    rA (or rB) inside the registers to load is an invalid form; it is not checked.
+*/
+static constexpr uint32_t st1_4s_post16(uint8_t rn, uint8_t vt) { return I32(0x4c9f7800 | ((rn & 31) << 5) | (vt & 31)); }
+static constexpr uint32_t ld1_4s_post16(uint8_t rn, uint8_t vt) { return I32(0x4cdf7800 | ((rn & 31) << 5) | (vt & 31)); }
+
+static void stringEA(PPCTranslatorContext *tc, GPR &ea, uint8_t ra, int rb)
+{
+    if (rb < 0) {
+        if (ra == 0) tc->emit(mov_immed_u16(ea, 0, 0));
+        else tc->emit(mov_reg(ea, tc->mapGPRForRead(ra)));
+    } else {
+        GPR reg_rb = tc->mapGPRForRead(rb);
+        if (ra == 0) tc->emit(mov_reg(ea, reg_rb));
+        else tc->emit(add_reg(ea, tc->mapGPRForRead(ra), reg_rb, LSL, 0));
+    }
+}
+
+static int stringImmediate(PPCTranslatorContext *tc, uint32_t opcode, bool load)
+{
+    if (opcode & 1) return -1;
+
+    uint8_t rd = (opcode >> 21) & 31;
+    uint8_t ra = (opcode >> 16) & 31;
+    uint8_t nb = (opcode >> 11) & 31;
+    int n = nb ? nb : 32;
+
+    GPR ea = GPR::allocate();
+    GPR t = GPR::allocate();
+    stringEA(tc, ea, ra, -1);
+
+    for (int k = 0; 4 * k < n; k++) {
+        uint8_t r = (rd + k) & 31;
+        int left = n - 4 * k;
+        uint16_t off = 4 * k;
+
+        if (load) {
+            GPR reg = tc->mapGPRForWrite(r);
+            switch (left) {
+                case 1:
+                    tc->emit({ ldrb_offset(ea, reg, off), lsl(reg, reg, 24) });
+                    break;
+                case 2:
+                    tc->emit({ ldrh_offset(ea, reg, off), lsl(reg, reg, 16) });
+                    break;
+                case 3:
+                    tc->emit({
+                        ldrh_offset(ea, reg, off),
+                        ldrb_offset(ea, t, off + 2),
+                        lsl(reg, reg, 16),
+                        orr_reg(reg, reg, t, LSL, 8)
+                    });
+                    break;
+                default:
+                    tc->emit(ldr_offset(ea, reg, off));
+            }
+        } else {
+            GPR reg = tc->mapGPRForRead(r);
+            switch (left) {
+                case 1:
+                    tc->emit({ lsr(t, reg, 24), strb_offset(ea, t, off) });
+                    break;
+                case 2:
+                    tc->emit({ lsr(t, reg, 16), strh_offset(ea, t, off) });
+                    break;
+                case 3:
+                    tc->emit({ lsr(t, reg, 16), strh_offset(ea, t, off), lsr(t, reg, 8), strb_offset(ea, t, off + 2) });
+                    break;
+                default:
+                    tc->emit(str_offset(ea, reg, off));
+            }
+        }
+    }
+
+    tc->advancePC(4);
+
+    return 1;
+}
+
+/* All GPRs (and CR, XER, which follow them) to PPCState, or back. The register allocator must hold no GPR. */
+static void gprsMemory(PPCTranslatorContext *tc, GPR &ctx, GPR &p, bool store)
+{
+    for (int i = 0; i < 14; i += 2) {
+        if (store) tc->emit(stp(ctx, INT_REG_MAPPING[i], INT_REG_MAPPING[i + 1], 4 * i));
+        else tc->emit(ldp(ctx, INT_REG_MAPPING[i], INT_REG_MAPPING[i + 1], 4 * i));
+    }
+    tc->emit(add64_immed(p, ctx, __builtin_offsetof(PPCState, GPR[14])));
+    for (uint8_t v = GPR14_VN; v <= GPR30_VN; v++)
+        tc->emit(store ? st1_4s_post16(p, v) : ld1_4s_post16(p, v));
+}
+
+static int stringIndexed(PPCTranslatorContext *tc, uint32_t opcode, bool load)
+{
+    if (opcode & 1) return -1;
+
+    uint8_t rd = (opcode >> 21) & 31;
+    uint8_t ra = (opcode >> 16) & 31;
+    uint8_t rb = (opcode >> 11) & 31;
+
+    GPR ctx = tc->getCTX();
+    GPR ea = GPR::allocate();
+    GPR n = GPR::allocate();
+
+    stringEA(tc, ea, ra, rb);
+    tc->emit(and_immed(n, tc->mapGPRForRead(XERn), 7, 0));
+
+    /* Everything back to the GPR lanes and the fixed registers; nothing stays in the allocator */
+    tc->flushAllGPRs();
+
+    GPR p = GPR::allocate();
+    GPR t = GPR::allocate();
+    GPR idx = GPR::allocate();
+
+    uint32_t *skip = tc->tc_CodePtr;
+    tc->emit(cbz(n, 0));
+
+    gprsMemory(tc, ctx, p, true);
+    tc->emit(mov_immed_u16(idx, 4 * rd, 0));
+
+    uint32_t *loop = tc->tc_CodePtr;
+    if (load) {
+        tc->emit({
+            ldrb_offset_postindex(ea, t, 1),
+            strb_regoffset(ctx, t, idx, UXTW)
+        });
+    } else {
+        tc->emit({
+            ldrb_regoffset(ctx, t, idx, UXTW),
+            strb_offset_postindex(ea, t, 1)
+        });
+    }
+    tc->emit({
+        add_immed(idx, idx, 1),
+        and_immed(idx, idx, 7, 0),
+        subs_immed(n, n, 1)
+    });
+    tc->emit(b_cc(A64_CC_NE, loop - tc->tc_CodePtr));
+
+    if (load) {
+        /* Clear the rest of the last register */
+        uint32_t *fill = tc->tc_CodePtr;
+        tc->emit({
+            tst_immed(idx, 2, 0),
+            b_cc(A64_CC_EQ, 5),
+            strb_regoffset(ctx, WZR, idx, UXTW),
+            add_immed(idx, idx, 1),
+            and_immed(idx, idx, 7, 0)
+        });
+        tc->emit(b(fill - tc->tc_CodePtr));
+        gprsMemory(tc, ctx, p, false);
+    }
+
+    *skip = cbz(n, tc->tc_CodePtr - skip);
+
+    tc->advancePC(4);
+
+    return 1;
+}
+
+int lswi(PPCTranslatorContext *tc, uint32_t opcode) { return stringImmediate(tc, opcode, true); }
+int stswi(PPCTranslatorContext *tc, uint32_t opcode) { return stringImmediate(tc, opcode, false); }
+int lswx(PPCTranslatorContext *tc, uint32_t opcode) { return stringIndexed(tc, opcode, true); }
+int stswx(PPCTranslatorContext *tc, uint32_t opcode) { return stringIndexed(tc, opcode, false); }
+
 }
