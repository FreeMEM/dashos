-            orr_immed(reg_xer, reg_xer, 2, 2),
-            bic_immed(tmp, reg_xer, 1, 2),
-            csel(reg_xer, reg_xer, tmp, A64_CC_NE)
+            sxtw64(tmp, reg_rd),                    // DashOS F1h: the 64-bit product fits in 32 bits?
