+/*
+    DashOS (F1e, docs/PPC_LOOP.md): the FPSCR exception bits and the record forms (Rc = 1: CR1 = FPSCR[FX, FEX, VX,
+    OX]), checked against qemu-ppc.
+
+    ARM keeps its own sticky flags in FPSR: IOC (invalid), DZC (divide by zero), OFC, UFC and IXC (inexact). An FPU
+    operation that keeps FPSCR exact ("full" below) clears FPSR before it and turns FPSR into FPSCR bits after it:
+    OX, UX, ZX and XX (sticky), FI (this operation was inexact), FX (any exception; like qemu-ppc, also when the bit
+    was already set), and with IOC the VX bit of the cause, worked out from the operands only in that case (VXSNAN,
+    VXISI, VXIDI, VXZDZ, VXIMZ, VXVC, VXSQRT, VXCVI). FPRF comes from the class of the result (fcmpu/fcmpo: FPCC
+    only; fctiw/fctiwz: left as it is, QNaN class on an invalid conversion, as qemu-ppc). VX and FEX are summaries.
+    FR is left as it is: qemu-ppc never sets it, and it would need the exact result. An enabled exception (VE, OE,
+    UE, ZE, XE) only shows in FEX: there is no program exception and the result is the one of the disabled case.
+
+    PPC_FPSCR_EXCEPTIONS = 1: every FPU operation is "full" (the test bench). 0, the default, keeps Emu68's fast
+    path: only the record forms are "full"; the other operations are translated as before and leave OX, UX, ZX and
+    XX in FPSR, which costs nothing and is folded into FPSCR (with FX) when FPSCR is read (mffs, mtfs*, mcrfs, a
+    record form) and when the context is saved (PPC_ExecutionLoop.cpp). FI, FPRF and the VX bits then come only from
+    the record forms.
+*/
+#define sys_FPSR 3,3,4,4,1
+
+static constexpr uint32_t FPSCR_FX = 1u << 31, FPSCR_OX = 1u << 28, FPSCR_UX = 1u << 27, FPSCR_ZX = 1u << 26,
+    FPSCR_XX = 1u << 25, FPSCR_VXSNAN = 1u << 24, FPSCR_VXISI = 1u << 23, FPSCR_VXIDI = 1u << 22,
+    FPSCR_VXZDZ = 1u << 21, FPSCR_VXIMZ = 1u << 20, FPSCR_VXVC = 1u << 19, FPSCR_FR = 1u << 18, FPSCR_FI = 1u << 17,
+    FPSCR_VXSQRT = 1u << 9, FPSCR_VXCVI = 1u << 8;
+
+static constexpr uint32_t ccmp64_imm(uint8_t rn, uint8_t imm5, uint8_t nzcv, uint8_t cond)
+{
+    return I32(0xfa400800 | ((imm5 & 31) << 16) | ((cond & 15) << 12) | ((rn & 31) << 5) | (nzcv & 15));
+}
+
+enum class FpKind { ADDSUB, MUL, DIV, FMA, SQRT, RSP };
+
+/*
+    The code that runs only sometimes (behind tbz/cbz) must not allocate registers: an allocation may spill a PPC
+    register to its slot, and the spill would be skipped on the other path while the allocator takes it as done. So
+    the helpers below take their temporaries from the caller, which allocates them before the branch.
+*/
+
+/* VX = any VX* bit; FEX = any exception bit with its enable bit */
+static void fpscrSummary(PPCTranslatorContext *tc, GPR &f, uint8_t t, uint8_t u)
+{
+    tc->emit({
+        and_immed(t, f, 6, 13),                     /* VXSNAN ... VXVC */
+        and_immed(u, f, 3, 24),                     /* VXSOFT, VXSQRT, VXCVI */
+        orr_reg(t, t, u, LSL, 0),
+        cmp_immed(t, 0),
+        cset(t, A64_CC_NE),
+        bfi(f, t, 29, 1),                           /* VX */
+        lsr(t, f, 25),
+        and_reg(t, t, f, LSR, 3),                   /* OX UX ZX XX against OE UE ZE XE */
+        and_immed(t, t, 4, 0),
+        lsr(u, f, 29),
+        and_reg(u, u, f, LSR, 7),                   /* VX against VE */
+        and_immed(u, u, 1, 0),
+        orr_reg(t, t, u, LSL, 0),
+        cmp_immed(t, 0),
+        cset(t, A64_CC_NE),
+        bfi(f, t, 30, 1)                            /* FEX */
+    });
+}
+
+static void fpscrSummary(PPCTranslatorContext *tc, GPR &f)
+{
+    GPR t = GPR::allocate();
+    GPR u = GPR::allocate();
+    fpscrSummary(tc, f, t, u);
+}
+
+/* OX, UX, ZX, XX and FX (and FI, if fi) from the ARM flags in s; FX if any flag of mask (0x1f with IOC, 0x1e not) */
+static void fpsrBits(PPCTranslatorContext *tc, GPR &f, GPR &s, bool with_ioc, bool fi, uint8_t t)
+{
+    tc->emit({
+        ubfx(t, s, 2, 1), orr_reg(f, f, t, LSL, 28),       /* OFC -> OX */
+        ubfx(t, s, 3, 1), orr_reg(f, f, t, LSL, 27),       /* UFC -> UX */
+        ubfx(t, s, 1, 1), orr_reg(f, f, t, LSL, 26),       /* DZC -> ZX */
+        ubfx(t, s, 4, 1), orr_reg(f, f, t, LSL, 25)        /* IXC -> XX */
+    });
+    if (fi) tc->emit(bfi(f, t, 17, 1));                     /* IXC -> FI */
+    tc->emit({
+        with_ioc ? tst_immed(s, 5, 0) : tst_immed(s, 4, 31),
+        cset(t, A64_CC_NE),
+        orr_reg(f, f, t, LSL, 31)                           /* FX */
+    });
+}
+
+#if !PPC_FPSCR_EXCEPTIONS
+/* The flags the fast path left in FPSR, into FPSCR; FPSR is cleared. IOC is dropped: its cause is not known */
+static void fpsrFold(PPCTranslatorContext *tc, GPR &f)
+{
+    GPR s = GPR::allocate();
+    GPR t = GPR::allocate();
+    GPR u = GPR::allocate();
+    tc->emit({ mrs(s, sys_FPSR), tst_immed(s, 4, 31) });
+    uint32_t *skip = tc->tc_CodePtr;
+    tc->emit(b_cc(A64_CC_EQ, 0));
+    fpsrBits(tc, f, s, false, false, t);
+    fpscrSummary(tc, f, t, u);
+    *skip = b_cc(A64_CC_EQ, tc->tc_CodePtr - skip);
+    tc->emit(msr(31, sys_FPSR));
+}
+#endif
+
+/* Before a "full" operation: FPSR clear (with the fast path, what it held goes into FPSCR first) */
+static void fpBegin(PPCTranslatorContext *tc, GPR &f)
+{
+#if PPC_FPSCR_EXCEPTIONS
+    (void)f;
+    tc->emit(msr(31, sys_FPSR));
+#else
+    fpsrFold(tc, f);
+#endif
+}
+
+/* Before reading FPSCR outside an operation (mffs, mtfs*, mcrfs, the record forms that raise nothing) */
+static void fpscrRead(PPCTranslatorContext *tc, GPR &f)
+{
+#if PPC_FPSCR_EXCEPTIONS
+    (void)tc; (void)f;
+#else
+    fpsrFold(tc, f);
+#endif
+}
+
+/* CR1 = FPSCR[0-3] */
+static void setCR1(PPCTranslatorContext *tc, GPR &f)
+{
+    GPR cr = tc->mapGPRForReadAndWrite(CRn);
+    GPR t = GPR::allocate();
+    tc->emit({ lsr(t, f, 28), bfi(cr, t, 24, 4) });
+}
+
+/* FPRF from the class of d: QNaN 0x11, -inf 0x09, -normal 0x08, -denormal 0x18, -0 0x12, +0 0x02, +denormal 0x14,
+   +normal 0x04, +inf 0x05 */
+static void setFPRF(PPCTranslatorContext *tc, GPR &f, uint8_t d)
+{
+    GPR x = GPR::allocate();
+    GPR e = GPR::allocate();
+    GPR v = GPR::allocate();
+    GPR t = GPR::allocate();
+    tc->emit({
+        fmov_to_x(x, d),
+        ubfx64(e, x, 52, 11),
+        fcmpzd(d),
+        mov_immed_u16(v, 0x02, 0),
+        mov_immed_u16(t, 0x08, 0), csel(v, t, v, A64_CC_MI),
+        mov_immed_u16(t, 0x04, 0), csel(v, t, v, A64_CC_GT),
+        mov_immed_u16(t, 0x11, 0), csel(v, t, v, A64_CC_VS),
+        cmp_immed(e, 0),
+        ccmp64_imm(x, 0, 4, A64_CC_EQ),             /* exponent 0 and not +0: denormal or -0, C */
+        cset(t, A64_CC_NE),
+        orr_reg(v, v, t, LSL, 4),
+        cmp_immed(e, 0x7ff),                        /* infinity (a NaN has FU already): FU */
+        cset(t, A64_CC_EQ),
+        orr_reg(v, v, t, LSL, 0),
+        bfi(f, v, 12, 5)
+    });
+}
+
+/* out = 1 if one of the registers (0xff: none) holds a signaling NaN */
+static void anySNaN(PPCTranslatorContext *tc, uint8_t out, uint8_t t, uint8_t u, uint8_t r0, uint8_t r1 = 0xff,
+                    uint8_t r2 = 0xff)
+{
+    tc->emit(mov_immed_u16(out, 0, 0));
+    for (uint8_t r : { r0, r1, r2 }) {
+        if (r == 0xff) continue;
+        tc->emit({
+            fmov_to_x(t, r),
+            fcmpd(r, r),
+            cset(u, A64_CC_VS),
+            tst64_immed(t, 1, 13, 1),               /* the quiet bit (51) */
+            csel(u, u, WZR, A64_CC_EQ),
+            orr_reg(out, out, u, LSL, 0)
+        });
+    }
+}
+
+/* v = cond != 0 ? yes : no */
+static void pick(PPCTranslatorContext *tc, uint8_t v, uint8_t cond, uint32_t yes, uint32_t no, uint8_t y, uint8_t n)
+{
+    tc->emitLoadImmediate(y, yes);
+    tc->emitLoadImmediate(n, no);
+    tc->emit({ cmp_immed(cond, 0), csel(v, y, n, A64_CC_NE) });
+}
