+/*
+    DashOS (F1e): with PPC_FPSCR_EXCEPTIONS = 0 the FPU operations leave their overflow, underflow, divide by zero
+    and inexact flags in the ARM FPSR (PPC_FPU.cpp); they go into FPSCR (OX, UX, ZX, XX, FX, and FEX) when the
+    context is saved, and FPSR starts clean when it is loaded (the C code in between may have used the FPU)
+*/
+static void foldFPSR(struct PPCState *ctx)
+{
+#if !PPC_FPSCR_EXCEPTIONS
+    uint64_t s;
+    __asm__ volatile("mrs %0, fpsr" : "=r"(s));
+    if (s & 0x1e) {
+        uint32_t f = ctx->FPSCR | 0x80000000;
+        if (s & 4) f |= 0x10000000;
+        if (s & 8) f |= 0x08000000;
+        if (s & 2) f |= 0x04000000;
+        if (s & 16) f |= 0x02000000;
+        if (((f >> 25) & (f >> 3) & 0xf) || ((f >> 29) & (f >> 7) & 1)) f |= 0x40000000;
+        ctx->FPSCR = f;
+    }
+#else
+    (void)ctx;
+#endif
+}
+
