+/*
+    DashOS: la máquina virt no tiene framebuffer. start.c y PPC_ExecutionLoop.cpp
+    los declaran extern, y en raspi los define start_rpi64.c.
+*/
+uint16_t *framebuffer = 0;
+uint32_t pitch = 0;
+uint32_t fb_width = 0;
+uint32_t fb_height = 0;
+
+/* capstone (Mapping.c) llama a printf en sus mensajes de error. */
+int printf(const char * restrict format, ...)
+{
+    va_list v;
+    va_start(v, format);
+    vkprintf_pc(putByte, (void*)0x09000000, format, v);
+    va_end(v);
+    return 0;
+}
