diff --git a/include/M68k_Endian.h b/include/M68k_Endian.h
index 7662800..1d8f148 100644
--- a/include/M68k_Endian.h
+++ b/include/M68k_Endian.h
@@ -97,6 +97,16 @@ static inline __attribute__((always_inline)) void EMIT_SwapBE(struct TranslatorC
         EMIT(ctx, rev_be(size, reg, reg));
 }
 
+/* Una carga suelta de la memoria del 68k en `reg`, y un guardado suelto de `reg` (en la instrucción del guardado, el
+   registro que se guarda se escribe __be). En big-endian son la instrucción tal cual. */
+#define EMIT_LD(ctx, size, ext, reg, insn) do { EMIT(ctx, insn); EMIT_LoadBE(ctx, size, reg, ext); } while (0)
+#define EMIT_ST(ctx, size, reg, insn) do { uint8_t __be = EMIT_StoreBE(ctx, size, reg); EMIT(ctx, insn); EMIT_StoreBE_Done(ctx, __be, reg); } while (0)
+
+/* Pares de 32 bits (LDP/STP de registros W): los dos registros, en la instrucción del guardado __be1 y __be2 */
+#define EMIT_LDP(ctx, r1, r2, insn) do { EMIT(ctx, insn); EMIT_LoadBE(ctx, 4, r1, BE_UNSIGNED); EMIT_LoadBE(ctx, 4, r2, BE_UNSIGNED); } while (0)
+#define EMIT_STP(ctx, r1, r2, insn) do { uint8_t __be1 = EMIT_StoreBE(ctx, 4, r1); uint8_t __be2 = EMIT_StoreBE(ctx, 4, r2); \
+    EMIT(ctx, insn); EMIT_StoreBE_Done(ctx, __be2, r2); EMIT_StoreBE_Done(ctx, __be1, r1); } while (0)
+
 #if EMU68_HOST_LE
 #define ldrsh_offset_be(rn, rt, off)            ldrh_offset(rn, rt, off)
 #define ldursh_offset_be(rn, rt, off)           ldurh_offset(rn, rt, off)
