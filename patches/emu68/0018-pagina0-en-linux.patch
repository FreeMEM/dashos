+#ifdef DASHOS_PAGINA0
+/* DashOS en Linux: la página 0 del 68k (ExecBase en la 4) no se puede proyectar en la dirección 0 sin ser root
+   (vm.mmap_min_addr). Su copia de solo lectura está en DASHOS_PAGINA0: una lectura con dirección absoluta que cae en la
