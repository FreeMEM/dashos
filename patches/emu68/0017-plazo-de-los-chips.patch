From: DashOS
Subject: [PATCH] K8: el plazo de los chips del Amiga entre bloques (contador hacia atras)

DashOS, K8 (docs/CHIPS_LOOP.md): con INTF.CHIPS a 1, MainLoop mira el contador de instrucciones contra
dashos_plazo al volver de cada bloque y, al llegar, llama a dashos_plazo_llegado (caja/motor_emu68.c). Con
INTF.CHIPS a 0, nada cambia.

---
diff --git a/include/M68k.h b/include/M68k.h
--- a/include/M68k.h
+++ b/include/M68k.h
@@ -168,6 +168,8 @@
             uint8_t IPL;
             uint8_t RESET;
             uint8_t PPC;
+            /* DashOS (K8): los chips del Amiga tienen un plazo armado (dashos_plazo, ExecutionLoop.c) */
+            uint8_t CHIPS;
         } INTF;
         uint64_t INT64;
     } __attribute__((aligned(8)));
diff --git a/src/ExecutionLoop.c b/src/ExecutionLoop.c
--- a/src/ExecutionLoop.c
+++ b/src/ExecutionLoop.c
@@ -17,6 +17,15 @@
 
 register uint32_t PC __asm__("w18");
 register void (*ARMCode)() __asm__("x12");
+
+#ifdef DASHOS_HOST
+/* DashOS (K8): el contador hacia atrás de los chips del Amiga. Con INTF.CHIPS a 1, INT64 no es 0: el código traducido
+   vuelve aquí tras cada bloque (también en los bucles internos), y aquí, si el contador de instrucciones llega a
+   dashos_plazo, se llama a dashos_plazo_llegado (que pone los chips al día y vuelve a armar el plazo). Con INTF.CHIPS
+   a 0 (los chips apagados) no cuesta nada. Las dos, débiles: quien no las define (jit-host) se queda sin plazo. */
+__attribute__((weak)) uint64_t dashos_plazo = ~0ULL;
+__attribute__((weak)) void dashos_plazo_llegado(void) { dashos_plazo = ~0ULL; }
+#endif
 extern uint32_t EPOCH;
 
 static inline uint32_t getLastPC()
@@ -329,6 +338,23 @@
             uint32_t vector;
             uint32_t vbr;
 
+#if defined(DASHOS_HOST) && EMU68_INSN_COUNTER
+            if (ctx->INTF.CHIPS)
+            {
+                uint64_t insn;
+                __asm__ volatile("umov %0, "CTX_INSN_COUNT_ASM:"=r"(insn));
+                if (insn >= dashos_plazo)
+                {
+                    /* C (y Rust) de fuera: como al traducir, el contexto se guarda y se vuelve a cargar; x12
+                       (ARMCode) no sobrevive a Rust, así que la unidad se vuelve a buscar */
+                    M68K_SaveContext(ctx);
+                    dashos_plazo_llegado();
+                    M68K_LoadContext(getCTX());
+                    LastPC = 0xffffffff;
+                }
+            }
+#endif
+
             /* Find out requested IPL level based on ARM state and real IPL line */
             if (ctx->INTF.ARM_err)
             {
