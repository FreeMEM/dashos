     {
-        *(uint64_t *)base = value | 0x000f000000000000ULL;
+        *(uint64_t *)base = M64(value | 0x000f000000000000ULL);
         *(uint32_t *)(base + 8) = 0;
         return;
     }
@@ -65,7 +76,7 @@ void Store96bit(uint64_t value, uintptr_t base)
