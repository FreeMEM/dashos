     {
-        *(uint64_t *)base = value;
+        *(uint64_t *)base = M64(value);
         *(uint32_t *)(base + 8) = 0;
         return;
     }
@@ -57,7 +68,7 @@ void Store96bit(uint64_t value, uintptr_t base)
     /* Store plus/minus infinity */
