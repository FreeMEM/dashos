+/* DashOS (U7): la memoria del 68k es big-endian también cuando el JIT corre en little-endian */
+#if __BYTE_ORDER__ == __ORDER_LITTLE_ENDIAN__
+#define M16(x) __builtin_bswap16(x)
+#define M32(x) __builtin_bswap32(x)
+#define M64(x) __builtin_bswap64(x)
+#else
+#define M16(x) (x)
+#define M32(x) (x)
+#define M64(x) (x)
+#endif
+
 uint64_t Load96bit(uintptr_t __ignore, uintptr_t base)
 {
     (void)__ignore;
     
-    uint16_t exp = *(uint16_t *)base;
-    uint64_t mant = *(uint64_t *)(base + 4);
+    uint16_t exp = M16(*(uint16_t *)base);
+    uint64_t mant = M64(*(uint64_t *)(base + 4));
     uint64_t ret;
 
     /* Load zero, positive or negative */
