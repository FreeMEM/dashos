     EMIT(ctx, insn); EMIT_StoreBE_Done(ctx, __be2, r2); EMIT_StoreBE_Done(ctx, __be1, r1); } while (0)
 
+/* FPU: REV64 y REV32 de vectores (8B), para un Double o un Float en un registro de la FPU (ARM DDI 0487, C7.2) */
+static inline __attribute__((always_inline)) uint32_t vrev64_8b(uint8_t rd, uint8_t rn) { return I32(0x0e200800 | (rd & 31) | ((rn & 31) << 5)); }
+static inline __attribute__((always_inline)) uint32_t vrev32_8b(uint8_t rd, uint8_t rn) { return I32(0x2e200800 | (rd & 31) | ((rn & 31) << 5)); }
+
+/* Tras cargar un Double (8) o un Float (4) de la memoria del 68k en un registro de la FPU; o antes de guardarlo (de
+   `rn` a `rd`, que puede ser el mismo) */
+static inline __attribute__((always_inline)) void EMIT_FSwapBE(struct TranslatorContext *ctx, int size, uint8_t rd, uint8_t rn)
+{
+    if (EMU68_HOST_LE)
+        EMIT(ctx, size == 8 ? vrev64_8b(rd, rn) : vrev32_8b(rd, rn));
+}
