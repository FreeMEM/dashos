+    if (d >= 0 && d < 4096) {
+        tc->emit(add_immed(ea, base, d));
+    } else if (d < 0 && d > -4096) {
+        tc->emit(sub_immed(ea, base, -d));
+    } else {
+        if (d < 0) tc->emit(movn_immed_u16(ea, ~d & 0xffff, 0));
+        else tc->emit(mov_immed_u16(ea, d, 0));
+        tc->emit(add_reg(ea, base, ea, LSL, 0));
