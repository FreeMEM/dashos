+static void multipleEA(PPCTranslatorContext *tc, GPR &ea, uint8_t ra, int16_t d)
+{
+    if (ra == 0) {
+        if (d < 0) tc->emit(movn_immed_u16(ea, ~d & 0xffff, 0));
+        else tc->emit(mov_immed_u16(ea, d, 0));
+        return;
+    }
