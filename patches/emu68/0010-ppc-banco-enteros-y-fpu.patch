+    GPR reg_rb = (kind == Carry::SUBFE) ? tc->mapGPRForRead(rb) : GPR::allocate();
+    GPR reg_rd = tc->mapGPRForWrite(rd);
+    GPR tmp = GPR::allocate();
+    GPR reg_xer = tc->mapGPRForReadAndWrite(XERn);
+
+    if (kind == Carry::ADDME || kind == Carry::SUBFME)
+        tc->emit(movn_immed_u16(reg_rb, 0, 0));     /* -1 */
+
+    tc->emit({
+        ubfx(tmp, reg_xer, 29, 1),                  /* CA ... */
+        subs_immed(WZR, tmp, 1),                    /* ... into the C flag */
+        bic_immed(reg_xer, reg_xer, 1, 3)           /* CA = 0 */
+    });
+
+    switch (kind) {
+        case Carry::SUBFE:  tc->emit(sbcs(reg_rd, reg_rb, reg_ra)); break;
+        case Carry::ADDZE:  tc->emit(adcs(reg_rd, reg_ra, WZR)); break;
+        case Carry::ADDME:  tc->emit(adcs(reg_rd, reg_ra, reg_rb)); break;
+        case Carry::SUBFZE: tc->emit(sbcs(reg_rd, WZR, reg_ra)); break;
+        case Carry::SUBFME: tc->emit(sbcs(reg_rd, reg_rb, reg_ra)); break;
