diff --git a/src/PPC_FPU.cpp b/src/PPC_FPU.cpp
index 2ca20ee..841d094 100644
--- a/src/PPC_FPU.cpp
+++ b/src/PPC_FPU.cpp
@@ -221,4 +221,303 @@ int fmadd(PPCTranslatorContext *tc, uint32_t opcode)
     return 1;
 }
 
+
+/*
+    DashOS (F1d, docs/PPC_LOOP.md): lo que faltaba de la FPU, probado contra qemu-ppc.
+
+    - Codificaciones de ARM que A64.h no tiene (con I32: las instrucciones van en little-endian): las operaciones de dos y tres fuentes con su tipo (simple o doble),
+      las de una fuente (fneg, fabs, frintx, fcvt) y fcsel.
+    - PPC calcula las de precisión simple (grupo 59) en doble y redondea el resultado a simple: aquí, la operación
+      en doble y fcvt a simple y de vuelta (con un doble redondeo en casos muy raros).
+    - fmsub, fnmadd y fnmsub van a FNMSUB, FNMADD y FMSUB de ARM (las tres son con un solo redondeo, como en PPC).
+    - fcmpu/fcmpo: LT, GT, EQ y FU (sin orden, si hay un NaN) en el campo de CR. Antes, con un NaN salía LT.
+    - fctiw y fctiwz: la palabra alta del resultado (que PPC no define) con el signo, como qemu; un NaN da
+      0x80000000.
+    - FPSCR: mffs, mtfsf, mtfsfi, mtfsb0 y mtfsb1 guardan los bits de control (RN, NI y las habilitaciones) y
+      llevan RN al modo de redondeo de ARM (FPCR.RMode). Los bits de excepción (FX, VX..., XX) no se calculan.
+    - Las formas con punto (CR1 desde las excepciones de FPSCR) siguen sin hacer.
+*/
+static constexpr uint32_t fp2(uint8_t op, uint8_t type, uint8_t d, uint8_t n, uint8_t m)
+{
+    return I32(0x1e200800 | (type << 22) | ((m & 31) << 16) | (op << 12) | ((n & 31) << 5) | (d & 31));
+}
+static constexpr uint32_t fp3(uint8_t o1, uint8_t o0, uint8_t type, uint8_t d, uint8_t n, uint8_t m, uint8_t a)
+{
+    return I32(0x1f000000 | (type << 22) | (o1 << 21) | ((m & 31) << 16) | (o0 << 15) | ((a & 31) << 10) | ((n & 31) << 5) | (d & 31));
+}
+static constexpr uint32_t fp1(uint8_t op, uint8_t type, uint8_t d, uint8_t n)
+{
+    return I32(0x1e204000 | (type << 22) | (op << 15) | ((n & 31) << 5) | (d & 31));
+}
+static constexpr uint32_t fpcsel(uint8_t type, uint8_t d, uint8_t n, uint8_t m, uint8_t cond)
+{
+    return I32(0x1e200c00 | (type << 22) | ((m & 31) << 16) | ((cond & 15) << 12) | ((n & 31) << 5) | (d & 31));
+}
+enum { FMUL = 0, FDIV = 1, FADD = 2, FSUB = 3 };
+enum { F1_NEG = 2, F1_ABS = 1, F1_SQRT = 3, F1_TO_S = 4, F1_TO_D = 5, F1_RINTX = 14 };
+enum { T_S = 0, T_D = 1 };
+
+
+static constexpr uint32_t fmov_to_x(uint8_t xd, uint8_t dn) { return I32(0x9e660000 | ((dn & 31) << 5) | (xd & 31)); }
+
+/*
+    El NaN de PPC: si el resultado d es NaN, es el primero de frA, frB, frC que sea NaN, silenciado (el bit 51 a
+    1), o el NaN por defecto (0x7ff8000000000000) si no viene de ninguno (inf - inf...). ARM prefiere un NaN con
+    señal a uno silencioso, y FNMADD/FNMSUB/FMSUB cambian el signo del NaN del sumando. Solo en el camino del NaN.
+*/
+static void ppcNaN(PPCTranslatorContext *tc, FPR &d, uint8_t a, uint8_t b, uint8_t c)
+{
+    FPR t = FPR::allocate();
+    GPR x = GPR::allocate();
+    uint8_t ops[3] = { c, b, a };   /* del menos al más prioritario */
+    int n = 0;
+    for (int i = 0; i < 3; i++) if (ops[i] != 0xff) n += 2;
+    tc->emit({
+        fcmpd(d, d),
+        b_cc(A64_CC_VC, 1 + 2 + n + 3),            /* over the 2 + n + 3 that follow */
+        mov64_immed_u16(x, 0x7ff8, 3),
+        fmov_from_reg(t, x)
+    });
+    for (int i = 0; i < 3; i++) {
+        if (ops[i] == 0xff) continue;
+        tc->emit({ fcmpd(ops[i], ops[i]), fpcsel(T_D, t, ops[i], t, A64_CC_VS) });
+    }
+    tc->emit({
+        fmov_to_x(x, t),
+        orr64_immed(x, x, 1, 13, 1),
+        fmov_from_reg(d, x)
+    });
+}
+
+/* rd = el valor de rd redondeado a simple y vuelto a doble */
+static void toSingle(PPCTranslatorContext *tc, FPR &rd)
+{
+    tc->emit({ fp1(F1_TO_S, T_D, rd, rd), fp1(F1_TO_D, T_S, rd, rd) });
+}
+
+/* A-form: fadd, fsub, fmul, fdiv (simple o doble), fsqrt, fsel, fmadd y compañía */
+static int aForm(PPCTranslatorContext *tc, uint32_t opcode, bool single)
+{
+    uint8_t rd = (opcode >> 21) & 31;
+    uint8_t ra = (opcode >> 16) & 31;
+    uint8_t rb = (opcode >> 11) & 31;
+    uint8_t rc = (opcode >> 6) & 31;
+    uint8_t xo = (opcode >> 1) & 31;
+
+    if (opcode & 1) return -1;      /* con punto: CR1 desde FPSCR, sin hacer */
+
+    switch (xo) {
+        case 18: case 20: case 21: case 25: {
+            uint8_t src2 = (xo == 25) ? rc : rb;
+            FPR a = tc->mapFPRForRead(ra);
+            FPR b = tc->mapFPRForRead(src2);
+            FPR d = tc->mapFPRForWrite(rd);
+            uint8_t op = xo == 18 ? FDIV : xo == 20 ? FSUB : xo == 21 ? FADD : FMUL;
+            tc->emit(fp2(op, T_D, d, a, b));
+            ppcNaN(tc, d, a, b, 0xff);
+            if (single) toSingle(tc, d);
+            break;
+        }
+        case 22: {
+            FPR b = tc->mapFPRForRead(rb);
+            FPR d = tc->mapFPRForWrite(rd);
+            tc->emit(fp1(F1_SQRT, T_D, d, b));
+            if (single) toSingle(tc, d);
+            break;
+        }
+        case 23: {      /* fsel: frD = frA >= 0 ? frC : frB (un NaN: frB) */
+            if (single) return -1;
+            FPR a = tc->mapFPRForRead(ra);
+            FPR b = tc->mapFPRForRead(rb);
+            FPR c = tc->mapFPRForRead(rc);
+            FPR d = tc->mapFPRForWrite(rd);
+            tc->emit({ fcmpzd(a), fpcsel(T_D, d, c, b, A64_CC_GE) });
+            break;
+        }
+        case 28: case 29: case 30: case 31: {
+            FPR a = tc->mapFPRForRead(ra);
+            FPR b = tc->mapFPRForRead(rb);
+            FPR c = tc->mapFPRForRead(rc);
+            FPR d = tc->mapFPRForWrite(rd);
+            /* PPC: fmsub A*C-B, fmadd A*C+B, fnmsub -(A*C-B), fnmadd -(A*C+B): las dos últimas niegan el
+               resultado (también un cero), no los operandos. ARM (n*m, a): FMADD a+nm y FNMSUB -a+nm */
+            bool sub = (xo == 28 || xo == 30);
+            FPR t = FPR::allocate();
+            tc->emit(fp3(sub ? 1 : 0, sub ? 1 : 0, T_D, t, a, c, b));
+            if (xo == 30 || xo == 31) tc->emit(fp1(F1_NEG, T_D, d, t));
+            else tc->emit(fcpyd(d, t));
+            ppcNaN(tc, d, a, b, c);
+            if (single) toSingle(tc, d);
+            break;
+        }
+        default:
+            return -1;
+    }
+
+    tc->advancePC(4);
+    return 1;
+}
+
+int group59(PPCTranslatorContext *tc, uint32_t opcode) { return aForm(tc, opcode, true); }
+int group63A(PPCTranslatorContext *tc, uint32_t opcode) { return aForm(tc, opcode, false); }
+
+/* fcmpu y fcmpo: el campo de CR con LT, GT, EQ o FU */
+int fcmp(PPCTranslatorContext *tc, uint32_t opcode)
+{
+    if (opcode & 0x00600001) return -1;
+
+    uint8_t crn = (opcode >> 23) & 7;
+    uint8_t ra = (opcode >> 16) & 31;
+    uint8_t rb = (opcode >> 11) & 31;
+
+    FPR a = tc->mapFPRForRead(ra);
+    FPR b = tc->mapFPRForRead(rb);
+    GPR cr = tc->mapGPRForReadAndWrite(CRn);
+    GPR v = GPR::allocate();
+    GPR t = GPR::allocate();
+
+    tc->emit({
+        fcmpd(a, b),
+        mov_immed_u16(v, 1, 0),                     /* FU */
+        mov_immed_u16(t, 8, 0), csel(v, t, v, A64_CC_MI),   /* LT */
+        mov_immed_u16(t, 4, 0), csel(v, t, v, A64_CC_GT),   /* GT */
+        mov_immed_u16(t, 2, 0), csel(v, t, v, A64_CC_EQ),   /* EQ */
+        bfi(cr, v, 4 * (7 - crn), 4)
+    });
+
+    tc->advancePC(4);
+    return 1;
+}
+
+/* fctiw (con el redondeo actual) y fctiwz (hacia cero) */
+int fctiw(PPCTranslatorContext *tc, uint32_t opcode)
+{
+    if (opcode & 0x001f0001) return -1;
+
+    uint8_t rd = (opcode >> 21) & 31;
+    uint8_t rb = (opcode >> 11) & 31;
+    bool z = ((opcode >> 1) & 0x3ff) == 15;
+
+    FPR b = tc->mapFPRForRead(rb);
+    FPR d = tc->mapFPRForWrite(rd);
+    FPR r = FPR::allocate();
+    GPR lo = GPR::allocate();
+    GPR hi = GPR::allocate();
+
+    if (z) tc->emit(fcvtzs_Dto32(lo, b));
+    else tc->emit({ fp1(F1_RINTX, T_D, r, b), fcvtzs_Dto32(lo, r) });
+    tc->emit({
+        sxtw64(lo, lo),                             /* la palabra alta: el signo, como qemu ... */
+        fcmpd(b, b),                                /* NaN: sin orden */
+        mov_immed_u16(hi, 0x8000, 1),               /* ... salvo con un NaN: 0x0000000080000000 */
+        csel64(lo, hi, lo, A64_CC_VS),
+        fmov_from_reg(d, lo)
+    });
+
+    tc->advancePC(4);
+    return 1;
+}
+
+/* frsp, fneg, fabs, fnabs, fmr */
+int fUnary(PPCTranslatorContext *tc, uint32_t opcode)
+{
+    if (opcode & 0x001f0001) return -1;
+
+    uint8_t rd = (opcode >> 21) & 31;
+    uint8_t rb = (opcode >> 11) & 31;
+    uint32_t xo = (opcode >> 1) & 0x3ff;
+
+    FPR b = tc->mapFPRForRead(rb);
+    FPR d = tc->mapFPRForWrite(rd);
+
+    switch (xo) {
+        case 12: tc->emit({ fp1(F1_TO_S, T_D, d, b), fp1(F1_TO_D, T_S, d, d) }); break;
+        case 40: tc->emit(fp1(F1_NEG, T_D, d, b)); break;
+        case 264: tc->emit(fp1(F1_ABS, T_D, d, b)); break;
+        case 136: tc->emit({ fp1(F1_ABS, T_D, d, b), fp1(F1_NEG, T_D, d, d) }); break;
+        case 72: tc->emit(fcpyd(d, b)); break;
+        default: return -1;
+    }
+
+    tc->advancePC(4);
+    return 1;
+}
+
+/* FPSCR: lleva RN (bits 30-31 de PPC: 0 al más cercano, 1 a cero, 2 a +inf, 3 a -inf) a FPCR.RMode de ARM
+   (0 al más cercano, 1 a +inf, 2 a -inf, 3 a cero) */
+static void fpscrToFpcr(PPCTranslatorContext *tc, GPR &fpscr)
+{
+    GPR rn = GPR::allocate();
+    GPR t = GPR::allocate();
+    GPR fpcr = GPR::allocate();
+    tc->emit({
+        and_immed(rn, fpscr, 2, 0),                 /* RN */
+        /* 0 -> 0, 1 -> 3, 2 -> 1, 3 -> 2: una tabla de dos bits por entrada, 0b10011100 */
+        add_reg(rn, rn, rn, LSL, 0),
+        mov_immed_u16(t, 0x9c, 0),
+        lsrv(t, t, rn),
+        and_immed(t, t, 2, 0),
+        get_fpcr(fpcr),
+        bfi(fpcr, t, 22, 2),
+        set_fpcr(fpcr)
+    });
+}
+
+/* mffs: frD = 0 : FPSCR */
+int mffs(PPCTranslatorContext *tc, uint32_t opcode)
+{
+    if (opcode & 0x001ff801) return -1;
+    uint8_t rd = (opcode >> 21) & 31;
+    FPR d = tc->mapFPRForWrite(rd);
+    GPR f = tc->mapGPRForRead(FPSCRn);
+    GPR v = GPR::allocate();
+    GPR hi = GPR::allocate();
+    tc->emit({
+        mov_reg(v, f),                              /* la palabra alta a 0, como qemu */
+        fmov_from_reg(d, v)
+    });
+    tc->advancePC(4);
+    return 1;
+}
+
+/* mtfsf FM,frB / mtfsfi BF,U / mtfsb0 / mtfsb1: solo los bits que se guardan; luego el redondeo de ARM */
+int mtfs(PPCTranslatorContext *tc, uint32_t opcode)
+{
+    if (opcode & 1) return -1;
+    uint32_t xo = (opcode >> 1) & 0x3ff;
+    GPR f = tc->mapGPRForReadAndWrite(FPSCRn);
+
+    if (xo == 711) {            /* mtfsf */
+        uint8_t fm = (opcode >> 17) & 0xff;
+        uint8_t rb = (opcode >> 11) & 31;
+        uint32_t mask = 0;
+        for (int i = 0; i < 8; i++) if (fm & (1 << i)) mask |= 15u << (4 * i);
+        FPR b = tc->mapFPRForRead(rb);
+        GPR v = GPR::allocate();
+        GPR m = GPR::allocate();
+        tc->emit(mov_simd_to_reg(v, b, TS_S, 0));
+        tc->emitLoadImmediate(m, mask);
+        tc->emit({
+            and_reg(v, v, m, LSL, 0),
+            bic_reg(f, f, m, LSL, 0),
+            orr_reg(f, f, v, LSL, 0)
+        });
+    } else if (xo == 134) {     /* mtfsfi */
+        uint8_t bf = (opcode >> 23) & 7;
+        uint8_t u = (opcode >> 12) & 15;
+        GPR v = GPR::allocate();
+        tc->emit({ mov_immed_u16(v, u, 0), bfi(f, v, 4 * (7 - bf), 4) });
+    } else if (xo == 70 || xo == 38) {   /* mtfsb0, mtfsb1 */
+        uint8_t bt = (opcode >> 21) & 31;
+        if (xo == 70) tc->emit(bic_immed(f, f, 1, (bt + 1) & 31));
+        else tc->emit(orr_immed(f, f, 1, (bt + 1) & 31));
+    } else {
+        return -1;
+    }
+
+    fpscrToFpcr(tc, f);
+    tc->advancePC(4);
+    return 1;
+}
+
 } // Emu68::PPC::Emit
