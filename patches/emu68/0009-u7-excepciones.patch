      "0"(M68k_A7)
     );
 
@@ -72,7 +72,7 @@ uint32_t M68K_Exception(uint32_t M68k_SR, uint32_t type_and_format, uint32_t, ui
     M68k_SR &= ~(SR_T0 | SR_T1);
 
     uint32_t vbr = getCTX()->VBR + (type_and_format & 0x0fff);
-    M68k_PC = *(uint32_t *)(uintptr_t)vbr;
+    M68k_PC = BE32(*(uint32_t *)(uintptr_t)vbr);
 
     __asm__ volatile("": :"r"(M68k_PC));
 
