-        __asm__ volatile("str %w1, [%0, #-8]!\t\nstr %w2, [%0, #4]":"=r"(M68k_A7):"r"(fault),"r"(ea),"0"(M68k_A7));
+        __asm__ volatile("str %w1, [%0, #-8]!\t\nstr %w2, [%0, #4]":"=r"(M68k_A7):"r"(BE32(fault)),"r"(BE32(ea)),"0"(M68k_A7));
     }
 
     uint32_t tmp = M68k_SR;
@@ -61,9 +61,9 @@ uint32_t M68K_Exception(uint32_t M68k_SR, uint32_t type_and_format, uint32_t, ui
         "str  %w2, [%0, #2]     \n\t"
