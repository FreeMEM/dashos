diff --git a/src/ExecutionLoop.c b/src/ExecutionLoop.c
index f968d72..c2e4f7a 100644
--- a/src/ExecutionLoop.c
+++ b/src/ExecutionLoop.c
@@ -421,9 +421,10 @@ void MainLoop()
                 SR |= ((level & 7) << SRB_IPL);
 
                 /* Push exception frame */
-                __asm__ volatile("strh %w1, [%0, #-8]!":"=r"(sp):"r"(SRcopy),"0"(sp));
-                __asm__ volatile("str %w1, [%0, #2]": :"r"(sp),"r"(PC));
-                __asm__ volatile("strh %w1, [%0, #6]": :"r"(sp),"r"(vector));
+                /* DashOS (U7): el marco, en big-endian */
+                __asm__ volatile("strh %w1, [%0, #-8]!":"=r"(sp):"r"(BE16(SRcopy)),"0"(sp));
+                __asm__ volatile("str %w1, [%0, #2]": :"r"(sp),"r"(BE32(PC)));
+                __asm__ volatile("strh %w1, [%0, #6]": :"r"(sp),"r"(BE16(vector)));
 
                 /* Set SR */
                 setSR(SR);
@@ -433,6 +434,7 @@ void MainLoop()
 
                 /* Load PC */
                 __asm__ volatile("ldr %w0, [%1, %2]":"=r"(PC):"r"(vbr),"r"(vector)); 
+                PC = BE32(PC);
             }
 
             /* All interrupts masked or new PC loaded and stack swapped, continue with code execution */
diff --git a/src/M68k_ExceptionEntry.c b/src/M68k_ExceptionEntry.c
