diff --git a/include/M68k_Endian.h b/include/M68k_Endian.h
new file mode 100644
index 0000000..7662800
--- /dev/null
+++ b/include/M68k_Endian.h
@@ -0,0 +1,114 @@
+/*
+    DashOS (U7): la memoria del 68k es siempre big-endian.
+
+    En una CPU que no tiene big-endian en EL0 (las de Apple), el JIT se compila en little-endian y da la vuelta a los
+    bytes en cada acceso de 16, 32 o 64 bits a la memoria del 68k. Estas funciones lo hacen. En big-endian (la Pi,
+    QEMU) no emiten nada: el código generado es el de siempre.
+
+    Las cargas con signo de 16 bits (LDRSH) no sirven en little-endian: extienden el signo del byte que no es. Se
+    cargan sin signo (LDRH_BE*), se giran y se extienden (EMIT_LoadBE con ext).
+
+    This Source Code Form is subject to the terms of the
+    Mozilla Public License, v. 2.0. If a copy of the MPL was not distributed
+    with this file, You can obtain one at http://mozilla.org/MPL/2.0/.
+*/
+
+#ifndef _M68K_ENDIAN_H
+#define _M68K_ENDIAN_H
+
+#if __BYTE_ORDER__ == __ORDER_LITTLE_ENDIAN__
+#define EMU68_HOST_LE 1
+#else
+#define EMU68_HOST_LE 0
+#endif
+
+enum { BE_UNSIGNED = 0, BE_SXT32 = 1, BE_SXT64 = 2 };
+
+/* Las uniones { uint64_t u64; uint16_t u16[4]; } con que el JIT parte una dirección de C en cuatro MOVZ/MOVK cuentan
+   u16[0] como la parte alta, que es así solo en big-endian. U16IDX(n): la parte n desde arriba en los dos órdenes. */
+#define U16IDX(n) (EMU68_HOST_LE ? 3 - (n) : (n))
+
+/* Instrucciones de más que pone EMIT_LoadBE (para los saltos de distancia fija que la rodean) */
+static inline __attribute__((always_inline)) int LoadBE_Count(int size, int ext)
+{
+    if (!EMU68_HOST_LE || size < 2)
+        return 0;
+    return (size == 2 && ext != BE_UNSIGNED) ? 2 : 1;
+}
+
+/* Tras cargar `size` bytes (2, 4 u 8) de la memoria del 68k en `reg`: el valor en el orden de la CPU. Con ext, la
+   carga de 16 bits fue sin signo y se extiende a 32 (BE_SXT32) o 64 bits (BE_SXT64). */
+static inline __attribute__((always_inline)) void EMIT_LoadBE(struct TranslatorContext *ctx, int size, uint8_t reg, int ext)
+{
+    if (!EMU68_HOST_LE)
+        return;
+    switch (size)
+    {
+        case 2:
+            EMIT(ctx, rev16(reg, reg));
+            if (ext == BE_SXT32)
+                EMIT(ctx, sxth(reg, reg));
+            else if (ext == BE_SXT64)
+                EMIT(ctx, sxth64(reg, reg));
+            break;
+        case 4:
+            EMIT(ctx, rev(reg, reg));
+            break;
+        case 8:
+            EMIT(ctx, rev64(reg, reg));
+            break;
+    }
+}
+
+/* Lo mismo, como instrucción suelta para listas de EMIT: en big-endian, un NOP no se puede poner (cambiaría el código),
+   así que solo vale donde se sabe que es little-endian. */
+static inline __attribute__((always_inline)) uint32_t rev_be(int size, uint8_t rd, uint8_t rn)
+{
+    return size == 2 ? rev16(rd, rn) : size == 4 ? rev(rd, rn) : rev64(rd, rn);
+}
+
+/* Antes de guardar `size` bytes de `reg` en la memoria del 68k: el registro que hay que guardar. En little-endian, un
+   temporal con los bytes girados; en big-endian, `reg`. Se suelta con EMIT_StoreBE_Done(ctx, devuelto, reg). */
+static inline __attribute__((always_inline)) uint8_t EMIT_StoreBE(struct TranslatorContext *ctx, int size, uint8_t reg)
+{
+    if (!EMU68_HOST_LE || size < 2)
+        return reg;
+    uint8_t tmp = RA_AllocARMRegister(ctx);
+    EMIT(ctx, rev_be(size, tmp, reg));
+    return tmp;
+}
+
+static inline __attribute__((always_inline)) void EMIT_StoreBE_Done(struct TranslatorContext *ctx, uint8_t used, uint8_t reg)
+{
+    if (used != reg)
+        RA_FreeARMRegister(ctx, used);
+}
+
+/* Instrucciones de más que pone EMIT_StoreBE */
+static inline __attribute__((always_inline)) int StoreBE_Count(int size)
+{
+    return (EMU68_HOST_LE && size >= 2) ? 1 : 0;
+}
+
+/* Dar la vuelta en el sitio (un registro que ya es temporal), o nada en big-endian */
+static inline __attribute__((always_inline)) void EMIT_SwapBE(struct TranslatorContext *ctx, int size, uint8_t reg)
+{
+    if (EMU68_HOST_LE && size >= 2)
+        EMIT(ctx, rev_be(size, reg, reg));
+}
+
+#if EMU68_HOST_LE
+#define ldrsh_offset_be(rn, rt, off)            ldrh_offset(rn, rt, off)
+#define ldursh_offset_be(rn, rt, off)           ldurh_offset(rn, rt, off)
+#define ldrsh_offset_postindex_be(rn, rt, off)  ldrh_offset_postindex(rn, rt, off)
+#define ldrsh_offset_preindex_be(rn, rt, off)   ldrh_offset_preindex(rn, rt, off)
+#define ldrsh_regoffset_be(rn, rt, rm, e, l)    ldrh_regoffset(rn, rt, rm, e, l)
+#else
+#define ldrsh_offset_be(rn, rt, off)            ldrsh_offset(rn, rt, off)
+#define ldursh_offset_be(rn, rt, off)           ldursh_offset(rn, rt, off)
+#define ldrsh_offset_postindex_be(rn, rt, off)  ldrsh_offset_postindex(rn, rt, off)
+#define ldrsh_offset_preindex_be(rn, rt, off)   ldrsh_offset_preindex(rn, rt, off)
+#define ldrsh_regoffset_be(rn, rt, rm, e, l)    ldrsh_regoffset(rn, rt, rm, e, l)
+#endif
+
+#endif /* _M68K_ENDIAN_H */
